# Server
PORT=4000

# MongoDB Atlas connection string (cloud-hosted, not local/dockerized)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/office-app?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Google Sheets sync — one service account (read-only) shared across both
# linked Sheets below. Share each Sheet with the service account's email as
# Viewer for its sync to work.
# Path is relative to the backend container/host, e.g. ./secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json

# Form Data page (Google Form Sync)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_RANGE=Form Responses 1!A:F

# Entrepreneur Details page's synced submissions section (a separate Google
# Form/Sheet, e.g. an entrepreneur registration form)
GOOGLE_ENTREPRENEUR_SHEET_ID=your-entrepreneur-google-sheet-id
GOOGLE_ENTREPRENEUR_SHEET_RANGE=Form Responses 1!A:F

# Cron schedule for automatic sync of both sources above (default: every 5 minutes)
SYNC_CRON_SCHEDULE=*/5 * * * *

# CORS: comma-separated list of allowed origins (frontend LAN URL)
CORS_ORIGIN=http://localhost:3000
